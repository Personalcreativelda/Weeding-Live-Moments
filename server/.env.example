# ============================================================
# DOMÍNIOS — preencha isto primeiro
# ============================================================
# Este projeto usa DOIS domínios:
#
# 1) FRONTEND (client/, na Vercel ou no seu próprio container Docker)
#    — onde os convidados e o admin abrem o site.
#    Ex: https://momentos.seudominio.com
#    Vai em APP_URL e CLIENT_URL abaixo, E TAMBÉM em client/.env
#    (variável VITE_API_URL do outro lado).
#
# 2) API (este serviço) — o backend.
#    Ex: https://api.seudominio.com
#    É o domínio que você associa a ESTE container (no Coolify: aba
#    "Domains" deste serviço, que trata do SSL automaticamente).
#    Esse mesmo domínio é o que entra em VITE_API_URL no client/.env.
# ============================================================

# ---- App ----
APP_NAME=Wedding Live Moments
# Domínio do FRONTEND — sem barra final.
APP_URL=https://momentos.seudominio.com
NODE_ENV=production
# Porta interna que este container escuta — configure a mesma no
# campo "Port" do serviço no Coolify.
PORT=4100
# Mesmo domínio do FRONTEND — usado para CORS e cookies.
CLIENT_URL=https://momentos.seudominio.com

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets ----
# Must be at least 16 characters. Generate with: openssl rand -hex 32
DEVICE_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- MinIO / S3 (or Supabase Storage's S3-compatible endpoint) ----
S3_ENDPOINT=
S3_PORT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_USE_SSL=true
# Only set S3_PUBLIC_URL if the bucket is served through a public CDN/proxy.
# Leave empty to use short-lived signed URLs (recommended, matches spec section 3).
S3_PUBLIC_URL=

# ---- Uploads ----
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100

# ---- Admin (used only by the seed script) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
