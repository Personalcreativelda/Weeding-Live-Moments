# ---- App ----
APP_NAME=Wedding Live Moments
APP_URL=https://momentos.exemplo.com
NODE_ENV=production
PORT=4000
CLIENT_URL=https://momentos.exemplo.com

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets ----
DEVICE_HASH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- MinIO / S3 (already provisioned externally — do not deploy a new MinIO) ----
S3_ENDPOINT=
S3_PORT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_USE_SSL=true
# Only set S3_PUBLIC_URL if the bucket is served through a public CDN/proxy.
# Leave empty to use short-lived signed URLs (recommended, matches spec section 3).
S3_PUBLIC_URL=

# ---- Uploads ----
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100

# ---- Admin (used only by the seed script) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
